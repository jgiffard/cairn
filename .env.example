# ---------------------------------------------------------------------------
# Cairn — example environment. Copy to .env.local and fill in.
# Never commit a filled-in copy: .env* is gitignored except this file.
# ---------------------------------------------------------------------------

# Public base URL of your Cairn instance
CAIRN_BASE_URL=http://localhost:3000

# Private PostgreSQL connection used by the app and migration runner.
DATABASE_URL=postgresql://cairn_app:password@localhost:5432/cairn
# scripts/backup.sh connects as CAIRN_DB_USER, which defaults to `postgres` and
# is NOT the role above. Set it to match, or the nightly dump fails on a
# database this URL can reach perfectly well.

DATABASE_POOL_SIZE=10
DATABASE_STATEMENT_TIMEOUT_MS=15000
AUTH_SESSION_SECONDS=2592000
CAIRN_OPERATOR_EMAIL=operator@example.com
CAIRN_OPERATOR_PASSWORD=
CAIRN_OPERATOR_NAME=

# --- Storage ----------------------------------------------------------------
# Private local storage for task attachments and HMAC key for one-hour links.
CAIRN_ATTACHMENT_DIR=/data/attachments
CAIRN_ATTACHMENT_SIGNING_KEY=
CAIRN_ATTACHMENT_MAX_BYTES=10485760
# Or an S3 bucket instead of the directory, for containers with no persistent
# disk. Credentials come from the platform's role; the app still serves files.
# CAIRN_ATTACHMENT_BUCKET=
# CAIRN_ATTACHMENT_PREFIX=
# The bucket's region, when the platform sets no AWS_REGION.
# CAIRN_ATTACHMENT_REGION=eu-west-3

# --- Platforms with no one-off tasks (App Runner) ---------------------------
# Apply migrations when the container starts (safe with several at once).
# CAIRN_MIGRATE_ON_START=1
# Create the first administrator on start, only while there is none. Remove
# after the first start.
# CAIRN_BOOTSTRAP_ADMIN_EMAIL=
# CAIRN_BOOTSTRAP_ADMIN_PASSWORD=
# CAIRN_BOOTSTRAP_ADMIN_NAME=
# Verified TLS to Amazon RDS: the image carries the CA bundle.
# NODE_EXTRA_CA_CERTS=/etc/ssl/certs/rds-global-bundle.pem   (and ?sslmode=verify-full)
# Close live-update streams before a platform request cap (App Runner: 120s).
# CAIRN_SSE_MAX_SECONDS=100
# Proxies in front of the app that append to X-Forwarded-For (default 1).
# CAIRN_TRUSTED_PROXY_HOPS=1

# --- Deployment (only needed when running behind a reverse proxy) -----------
# The hostname your instance is served on, e.g. cairn.example.com
CAIRN_DOMAIN=cairn.example.com
# External Docker network your reverse proxy already runs on.
CAIRN_PROXY_NETWORK=web
CAIRN_DATABASE_NETWORK=cairn-data

# --- CLI --------------------------------------------------------------------
# Used by the `cairn` CLI and by agents. Create a key in Settings -> API keys.
# One key per agent, so writes are attributable and any one can be revoked.
CAIRN_API_KEY=
